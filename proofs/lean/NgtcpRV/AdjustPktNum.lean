/-- The C function, transcribed line by line with C's uint64_t semantics
    (`1ULL << s` is defined for s < 64, which the precondition guarantees). -/
def adjustC (max_pkt_num pkt_num pkt_numlen : BitVec 64) : BitVec 64 :=
  let expected := max_pkt_num + 1
  let win := 1#64 <<< (pkt_numlen * 8)
  let hwin := win / 2
  let mask := win - 1
  let cand := (expected &&& ~~~mask) ||| pkt_num
  if cand + hwin ≤ expected then cand + win
  else if cand > expected + hwin ∧ cand ≥ win then cand - win
  else cand


open NgtcpRV.Bits

/-! ## Layer 1: the machine code computes the C function

For every initial register file, running the 21 instructions from the entry
point returns to the caller (`pc = ra`) without a fault and leaves in `a0`
exactly the value of the C source under `uint64_t` semantics.  The only
assumptions are the calling convention (`a0..a2` = arguments, `ra` = return
address, which lies outside the function and is 4-byte aligned) and
`pkt_numlen < 8`, without which `1ULL << (pkt_numlen * 8)` is undefined in C.

All proofs in this file are checked by the Lean kernel; see `Audit.lean`. -/

set_option maxHeartbeats 2000000 in
theorem adjustPktNum_machine_eq_C (R : Reg → BitVec 64) (ra : BitVec 64)
    (h1 : R 1#5 = ra) (hra : ¬ ra < 84#64) (hal : ra &&& 3#64 = 0#64)
    (hlen : R 12#5 < 8#64) :
    let s := run adjustPktNum 19 {regs := R, pc := 0#64}
    s.pc = ra ∧ s.fault = false ∧ s.rd 10#5 = adjustC (R 10#5) (R 11#5) (R 12#5) := by
  have hj := align_clear0 ra hal
  have hb := align_bit1 ra hal
  simp only [run, step_lit, step_ite]
  simp (config := {maxSteps := 4000000}) [State.next, State.wr, State.rd, State.jump, exec,
    step_lit, step_ite, h1, hj, hb, hra]
  refine ⟨?_, ?_, ?_⟩
  · rw [apply_ite State.pc]; simp
  · rw [apply_ite State.fault]; simp
  · simp only [apply_ite State.regs, ite_app]
    rcases cases8 _ hlen with h|h|h|h|h|h|h|h <;>
      simp [h, adjustC, RV64.add, RV64.sub, RV64.and, RV64.or, RV64.sll, RV64.srli,
        RV64.slli, RV64.sltu, RV64.xori, RV64.addi, branchless_sub] <;>
      simp only [BitVec.add_comm 1#64 (R 10#5)]

/-! ## Layer 2: the C function meets RFC 9000

`MAX = 2^62 - 1` is `NGTCP2_MAX_PKT_NUM`.  `max_pkt_num` is the largest
packet number received so far, or `-1` (all ones) if none.  Comparisons that
the RFC states over unbounded integers are written over 128-bit vectors of
values below `2^64`, where no wrap-around can occur. -/

def MAX : BitVec 64 := 0x3FFFFFFFFFFFFFFF#64

/-- Preconditions under which ngtcp2 calls the function. -/
def Pre (M len : BitVec 64) : Prop :=
  (M = 0xFFFFFFFFFFFFFFFF#64 ∨ M ≤ MAX) ∧ 1#64 ≤ len ∧ len ≤ 4#64

/-- RFC 9000 §17.1 / Appendix A.3: if the sender's full packet number `P`
    lies in the window `(expected - hwin, expected + hwin]`, then decoding its
    `8 * len` low bits recovers `P` exactly. -/
theorem adjustC_recovers (M P len : BitVec 64) (hpre : Pre M len) (hP : P ≤ MAX)
    (hwin :
      let e := (M + 1).zeroExtend 128
      let hw := (1#128 <<< (len.zeroExtend 128 * 8 - 1))
      e < P.zeroExtend 128 + hw ∧ P.zeroExtend 128 ≤ e + hw) :
    adjustC M (P &&& ((1#64 <<< (len * 8)) - 1)) len = P := by
  obtain ⟨hM, hl1, hl4⟩ := hpre
  have hl : len.toNat = 1 ∨ len.toNat = 2 ∨ len.toNat = 3 ∨ len.toNat = 4 := by
    rw [BitVec.le_def] at hl1 hl4; simp at hl1 hl4; omega
  have hK64 : (len * 8).toNat = len.toNat * 8 := by
    rw [BitVec.toNat_mul]; simp; omega
  have hK128 : (BitVec.setWidth 128 len * 8 - 1).toNat = len.toNat * 8 - 1 := by
    rw [BitVec.toNat_sub, BitVec.toNat_mul, BitVec.toNat_setWidth]; simp; omega
  have hKlt : len.toNat * 8 < 64 := by omega
  -- the window, the half window and the masks as natural numbers
  have hW : (1#64 <<< (len.toNat * 8)).toNat = 2 ^ (len.toNat * 8) := by
    have hp : 2 ^ (len.toNat * 8) < 2 ^ 64 := Nat.pow_lt_pow_right (by decide) hKlt
    rw [BitVec.toNat_shiftLeft]; simp [Nat.one_shiftLeft]
    simpa using hp
  have hpm := toNat_and_lowMask P (len.toNat * 8) hKlt
  have hc := toNat_cand (M + 1) (P &&& ((1#64 <<< (len.toNat * 8)) - 1#64)) (len.toNat * 8) hKlt
    (by rw [hpm]; exact Nat.mod_lt _ (Nat.two_pow_pos _))
  rw [hpm] at hc
  have hhw : (1#128 <<< (len.toNat * 8 - 1)).toNat = 2 ^ (len.toNat * 8 - 1) := by
    have hp : 2 ^ (len.toNat * 8 - 1) < 2 ^ 128 := Nat.pow_lt_pow_right (by decide) (by omega)
    rw [BitVec.toNat_shiftLeft]; simp [Nat.one_shiftLeft]
    simpa using hp
  simp only [adjustC]
  simp only [BitVec.shiftLeft_eq' (y := len * 8), hK64] at hwin ⊢
  simp only [BitVec.shiftLeft_eq' (y := BitVec.setWidth 128 len * 8 - 1), hK128] at hwin
  generalize (M + 1 &&& ~~~((1#64 <<< (len.toNat * 8)) - 1) ||| P &&& (1#64 <<< (len.toNat * 8)) - 1) = c at hc ⊢
  generalize 1#64 <<< (len.toNat * 8) = W at hW ⊢
  generalize 1#128 <<< (len.toNat * 8 - 1) = hw at hhw hwin
  apply BitVec.eq_of_toNat_eq
  simp only [MAX, BitVec.le_def, BitVec.lt_def] at hM hP hwin
  have hPl := P.isLt; have hMl := M.isLt; have hcl := c.isLt
  have hdiv : (W / 2).toNat = 2 ^ (len.toNat * 8) / 2 := by rw [BitVec.toNat_udiv, hW]; simp
  have h1n : (1#64 : BitVec 64).toNat = 1 := rfl
  split
  next h1 =>
    simp only [BitVec.le_def, BitVec.lt_def, BitVec.toNat_add, hW, hdiv, h1n,
      BitVec.toNat_setWidth] at h1 hwin hc ⊢
    rcases hl with hl|hl|hl|hl <;> simp only [hl] at * <;> simp at * <;> omega
  next h1 =>
    split
    next h2 =>
      simp only [BitVec.le_def, BitVec.lt_def, BitVec.toNat_add, BitVec.toNat_sub, hW, hdiv, h1n,
        BitVec.toNat_setWidth] at h1 h2 hwin hc ⊢
      rcases hl with hl|hl|hl|hl <;> simp only [hl] at * <;> simp at * <;> omega
    next h2 =>
      simp only [BitVec.le_def, BitVec.lt_def, BitVec.toNat_add, hW, hdiv, h1n,
        BitVec.toNat_setWidth, not_and, Nat.not_lt, Nat.not_le] at h1 h2 hwin hc ⊢
      rcases hl with hl|hl|hl|hl <;> simp only [hl] at * <;> simp at * <;> omega

/-- The reference algorithm of RFC 9000 Appendix A.3 (pseudo-code transcribed;
    `candidate <= expected - hwin` is written `candidate + hwin <= expected`). -/
def rfcDecode (largest truncated len : BitVec 64) : BitVec 128 :=
  let expected := (largest + 1).zeroExtend 128
  let win := 1#128 <<< (len.zeroExtend 128 * 8)
  let hwin := win / 2
  let mask := win - 1
  let cand := (expected &&& ~~~mask) ||| truncated.zeroExtend 128
  if cand + hwin ≤ expected ∧ cand < (1#128 <<< 62) - win then cand + win
  else if cand > expected + hwin ∧ cand ≥ win then cand - win
  else cand

set_option maxHeartbeats 4000000 in
/-- Whenever ngtcp2 accepts the result (`≤ NGTCP2_MAX_PKT_NUM`), it equals the
    RFC reference decoding; and the result always keeps the received bits. -/
theorem adjustC_rfc (M pn len : BitVec 64) (hpre : Pre M len)
    (hpn : pn < 1#64 <<< (len * 8)) :
    (adjustC M pn len ≤ MAX → (adjustC M pn len).zeroExtend 128 = rfcDecode M pn len) ∧
    adjustC M pn len &&& ((1#64 <<< (len * 8)) - 1) = pn := by
  obtain ⟨hM, hl1, hl4⟩ := hpre
  have hl : len.toNat = 1 ∨ len.toNat = 2 ∨ len.toNat = 3 ∨ len.toNat = 4 := by
    rw [BitVec.le_def] at hl1 hl4; simp at hl1 hl4; omega
  have hKlt : len.toNat * 8 < 64 := by omega
  have hK64 : (len * 8).toNat = len.toNat * 8 := by
    rw [BitVec.toNat_mul]; simp; omega
  have hK128 : (BitVec.setWidth 128 len * 8).toNat = len.toNat * 8 := by
    rw [BitVec.toNat_mul, BitVec.toNat_setWidth]; simp; omega
  have hW : (1#64 <<< (len.toNat * 8)).toNat = 2 ^ (len.toNat * 8) := by
    have hp : 2 ^ (len.toNat * 8) < 2 ^ 64 := Nat.pow_lt_pow_right (by decide) hKlt
    rw [BitVec.toNat_shiftLeft]; simp [Nat.one_shiftLeft]; simpa using hp
  have hW' : (1#128 <<< (len.toNat * 8)).toNat = 2 ^ (len.toNat * 8) := by
    have hp : 2 ^ (len.toNat * 8) < 2 ^ 128 := Nat.pow_lt_pow_right (by decide) (by omega)
    rw [BitVec.toNat_shiftLeft]; simp [Nat.one_shiftLeft]; simpa using hp
  simp only [adjustC, rfcDecode]
  simp only [BitVec.shiftLeft_eq' (y := len * 8), hK64] at hpn ⊢
  simp only [BitVec.shiftLeft_eq' (y := BitVec.setWidth 128 len * 8), hK128]
  rw [BitVec.lt_def, hW] at hpn
  have hc := toNat_cand (M + 1) pn (len.toNat * 8) hKlt hpn
  have hc' := toNat_cand (BitVec.setWidth 128 (M + 1)) (BitVec.setWidth 128 pn) (len.toNat * 8)
    (by omega) (by rw [BitVec.toNat_setWidth, Nat.mod_eq_of_lt (by omega)]; exact hpn)
  have hmask := fun r => toNat_and_lowMask (w := 64) r (len.toNat * 8) hKlt
  generalize (M + 1 &&& ~~~((1#64 <<< (len.toNat * 8)) - 1) ||| pn) = c at hc ⊢
  generalize (BitVec.setWidth 128 (M + 1) &&& ~~~((1#128 <<< (len.toNat * 8)) - 1) |||
    BitVec.setWidth 128 pn) = c' at hc' ⊢
  generalize 1#64 <<< (len.toNat * 8) = W at hW hmask ⊢
  generalize 1#128 <<< (len.toNat * 8) = W' at hW' ⊢
  have hdiv : (W / 2).toNat = 2 ^ (len.toNat * 8) / 2 := by rw [BitVec.toNat_udiv, hW]; simp
  have hdiv' : (W' / 2).toNat = 2 ^ (len.toNat * 8) / 2 := by rw [BitVec.toNat_udiv, hW']; simp
  have h62 : ((1#128 <<< 62) - W').toNat = 2 ^ 62 - 2 ^ (len.toNat * 8) := by
    rw [BitVec.toNat_sub, hW']; simp
    rcases hl with hl|hl|hl|hl <;> simp [hl] <;> omega
  have hM' : M.toNat = 2 ^ 64 - 1 ∨ M.toNat ≤ 2 ^ 62 - 1 := by
    rcases hM with h | h
    · left; subst h; rfl
    · right; rw [MAX, BitVec.le_def] at h; simpa using h
  clear hM
  have hMl := M.isLt; have hpl := pn.isLt; have hcl := c.isLt; have hcl' := c'.isLt
  have h1n : (1#64 : BitVec 64).toNat = 1 := rfl
  simp only [BitVec.toNat_setWidth, BitVec.toNat_add, h1n] at hc'
  refine ⟨?_, ?_⟩
  · repeat' split
    all_goals
      (intro hmax
       apply BitVec.eq_of_toNat_eq
       simp only [MAX, BitVec.le_def, BitVec.lt_def, BitVec.toNat_add, BitVec.toNat_sub,
        BitVec.toNat_setWidth, hW, hW', hdiv, hdiv', h62, h1n, Bool.and_eq_true, decide_eq_true_eq,
        not_and, Nat.not_lt, Nat.not_le, and_imp] at *
       rcases hl with hl|hl|hl|hl <;> simp only [hl] at * <;> simp at * <;> omega)
  · apply BitVec.eq_of_toNat_eq
    rw [show (1 : BitVec 64) = 1#64 from rfl, hmask]
    repeat' split
    all_goals
      (simp only [BitVec.le_def, BitVec.lt_def, BitVec.toNat_add, BitVec.toNat_sub, hW, hdiv, h1n,
        not_and, Nat.not_lt, Nat.not_le] at * <;>
      rcases hl with hl|hl|hl|hl <;> simp only [hl] at * <;> simp at * <;> omega)

/-! ## The machine code meets RFC 9000 -/

theorem adjustPktNum_machine_recovers (R : Reg → BitVec 64) (ra P : BitVec 64)
    (h1 : R 1#5 = ra) (hra : ¬ ra < 84#64) (hal : ra &&& 3#64 = 0#64)
    (hpre : Pre (R 10#5) (R 12#5)) (hP : P ≤ MAX)
    (htrunc : R 11#5 = P &&& ((1#64 <<< (R 12#5 * 8)) - 1))
    (hwin :
      let e := (R 10#5 + 1).zeroExtend 128
      let hw := (1#128 <<< ((R 12#5).zeroExtend 128 * 8 - 1))
      e < P.zeroExtend 128 + hw ∧ P.zeroExtend 128 ≤ e + hw) :
    let s := run adjustPktNum 19 {regs := R, pc := 0#64}
    s.pc = ra ∧ s.fault = false ∧ s.rd 10#5 = P := by
  have hlen : R 12#5 < 8#64 := by
    obtain ⟨-, -, h4⟩ := hpre
    rw [BitVec.le_def] at h4; rw [BitVec.lt_def]; simp at h4 ⊢; omega
  obtain ⟨hpc, hf, hv⟩ := adjustPktNum_machine_eq_C R ra h1 hra hal hlen
  exact ⟨hpc, hf, hv.trans (htrunc ▸ adjustC_recovers _ P _ hpre hP hwin)⟩

theorem adjustPktNum_machine_rfc (R : Reg → BitVec 64) (ra : BitVec 64)
    (h1 : R 1#5 = ra) (hra : ¬ ra < 84#64) (hal : ra &&& 3#64 = 0#64)
    (hpre : Pre (R 10#5) (R 12#5)) (hpn : R 11#5 < 1#64 <<< (R 12#5 * 8)) :
    let s := run adjustPktNum 19 {regs := R, pc := 0#64}
    s.pc = ra ∧ s.fault = false ∧
    (s.rd 10#5 ≤ MAX → (s.rd 10#5).zeroExtend 128 = rfcDecode (R 10#5) (R 11#5) (R 12#5)) ∧
    s.rd 10#5 &&& ((1#64 <<< (R 12#5 * 8)) - 1) = R 11#5 := by
  have hlen : R 12#5 < 8#64 := by
    obtain ⟨-, -, h4⟩ := hpre
    rw [BitVec.le_def] at h4; rw [BitVec.lt_def]; simp at h4 ⊢; omega
  obtain ⟨hpc, hf, hv⟩ := adjustPktNum_machine_eq_C R ra h1 hra hal hlen
  simp only at hv ⊢
  rw [hv]
  exact ⟨hpc, hf, adjustC_rfc _ _ _ hpre hpn⟩

end NgtcpRV
