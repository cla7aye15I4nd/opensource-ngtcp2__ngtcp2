def adjustPktNum : Program := ⟨0, adjustPktNum_words⟩

/-- Our decoder agrees with LLVM's on every word of the program (kernel-checked). -/
theorem adjustPktNum_decode :
    adjustPktNum_words.map decode = adjustPktNum_llvm.map some := by
  decide


/-- Every program location fetches the instruction LLVM sees there. -/
theorem adjustPktNum_fetch (k : Fin 21) :
    adjustPktNum.fetch (BitVec.ofNat 64 (4 * k.val)) = some (adjustPktNum_llvm.get ⟨k.val, by simp [adjustPktNum_llvm]⟩) := by
  revert k; decide


@[simp] theorem adjustPktNum_base : adjustPktNum.base = 0#64 := rfl
@[simp] theorem adjustPktNum_len : adjustPktNum.words.length = 21 := rfl

